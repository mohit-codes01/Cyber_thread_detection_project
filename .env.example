# ==========================================
# CYBER THREAT DETECTOR - CONFIGURATION
# ==========================================

# Application Settings
APP_NAME="Cyber Threat Detector"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT="production"

# Database Configuration (SQLite by default, or postgresql://user:pass@localhost:5432/threat_db)
DATABASE_URL="sqlite:///./cyber_threat_detector.db"

# Security & Authentication (Generate a secure secret in production!)
SECRET_KEY="cyber-threat-detector-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Settings (1 GB limit)
MAX_UPLOAD_SIZE=1073741824
UPLOAD_DIR="./data/uploads"
SAMPLE_DIR="./data/sample"
REPORTS_DIR="./reports"

# Threat Detection Scoring Weights (Sum to 1.0)
WEIGHT_RULE=0.35
WEIGHT_ANOMALY=0.25
WEIGHT_ML=0.25
WEIGHT_INDICATOR=0.15

# Threat Intelligence (Optional external API key, local rules run regardless)
THREAT_INTEL_API_KEY=""

# CORS Origins (Comma separated or * for demo)
CORS_ORIGINS="*"
